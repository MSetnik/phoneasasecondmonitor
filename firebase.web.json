{
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "premium-audit.json",
      "assets/desk-scene.webp",
      "assets/Bricolage*",
      "assets/wordmark.svg",
      "assets/iap-unlock.webp"
    ],
    "rewrites": [
      {
        "source": "/api/license",
        "function": {
          "functionId": "displayLicense",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/stripe",
        "function": {
          "functionId": "displayWebhook",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "/downloads/**",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment"
          }
        ]
      },
      {
        "source": "/downloads/Phone-as-a-Second-Monitor-Windows-x64-Setup.exe",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/downloads/Phone-as-a-Second-Monitor-Windows-x64-Setup.exe",
        "destination": "https://storage.googleapis.com/phone-as-monitor-mcode-downloads/windows/x64/95d8a05d718c602003753c2621de54eb2bffc1bd67358e7381cf2d268552fd9b/Phone-as-a-Second-Monitor-Windows-x64-Setup.exe",
        "type": 302
      }
    ],
    "site": "phone-as-monitor-mcode"
  }
}
